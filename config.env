# Kit-wide settings. Sourced by scripts/*.sh. Override any of these in the environment.
KIT_ROOT="${KIT_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)}"
QEMU_REMOTE="${QEMU_REMOTE:-https://gitlab.com/qemu-project/qemu.git}"
QEMU_SRC="${QEMU_SRC:-$KIT_ROOT/qemu-src}"          # base clone, never edited directly
QEMU_BASE_REF="${QEMU_BASE_REF:-origin/master}"     # what new SoC branches start from
QEMU_TARGETS="${QEMU_TARGETS:-aarch64-softmmu}"          # also runs 32-bit Arm boards (A32 and M-profile)
QEMU_CONFIGURE_EXTRA="${QEMU_CONFIGURE_EXTRA:---disable-docs --enable-debug-info --enable-trace-backends=log}"

# Alternative base for SoCs that will be fuzzed with libafl_qemu (scripts/new-soc.sh --base libafl).
# Keep QEMU_LIBAFL_REF equal to LIBAFL_QEMU_GIT_REV in the LibAFL release you fuzz with
# (crates/libafl_qemu/libafl_qemu_build/src/build.rs); this one is QEMU 10.2.0 + LibAFL patches.
QEMU_LIBAFL_REMOTE="${QEMU_LIBAFL_REMOTE:-https://github.com/AFLplusplus/qemu-libafl-bridge.git}"
QEMU_LIBAFL_REF="${QEMU_LIBAFL_REF:-d7a6067ffc94fbb4caad409d390e099630b71941}"
# The fork (QEMU 10.2.0) predates GCC 16, which flags tests/unit/rcutorture.c under -Werror.
QEMU_LIBAFL_CONFIGURE_EXTRA="${QEMU_LIBAFL_CONFIGURE_EXTRA:---extra-cflags=-Wno-error=unused-but-set-variable}"
